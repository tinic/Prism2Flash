set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR m68k)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES AMIGA_TOOLCHAIN_ROOT)
if(NOT AMIGA_TOOLCHAIN_ROOT)
  set(AMIGA_TOOLCHAIN_ROOT "$ENV{AMIGA_TOOLCHAIN_ROOT}" CACHE PATH "m68k-amigaos toolchain root")
endif()
if(NOT EXISTS "${AMIGA_TOOLCHAIN_ROOT}/bin/m68k-amigaos-gcc")
  message(FATAL_ERROR "Set AMIGA_TOOLCHAIN_ROOT to the directory containing bin/m68k-amigaos-gcc")
endif()
set(CMAKE_C_COMPILER "${AMIGA_TOOLCHAIN_ROOT}/bin/m68k-amigaos-gcc" CACHE FILEPATH "Amiga C compiler" FORCE)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_FLAGS_INIT "-m68000 -O2 -fomit-frame-pointer")
set(PRISM2_AMIGA ON CACHE BOOL "Native Amiga build" FORCE)
